# Port the Express server listens on
PORT=5000

# Environment: development | production | test
NODE_ENV=development

# URL of the client app, used to configure CORS
CLIENT_URL=http://localhost:5173

# PostgreSQL connection string used by Prisma
# Format: postgresql://USER:PASSWORD@HOST:PORT/DATABASE?schema=public dummy url
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/attendly?schema=public

# Secret used to sign and verify JWTs.
# Generate a strong one with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=replace-this-with-a-long-random-string

# How long issued JWTs stay valid (jsonwebtoken "zeit/ms" format, e.g. 1h, 7d)
JWT_EXPIRES_IN=7d
